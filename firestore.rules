rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Super Admin helper strictly based on owner email
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email == 'roeliobinance@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // System Alerts collection
    match /systemAlerts/{alertId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(alertId);
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
        && incoming().uid == request.auth.uid
        && incoming().fullName is string && incoming().fullName.size() >= 1 && incoming().fullName.size() <= 80
        && incoming().userId is string && incoming().userId.size() >= 3 && incoming().userId.size() <= 30;
      allow update: if isSignedIn() && isValidId(userId) && (
        isAdmin() || (
          request.auth.uid == userId
          && incoming().uid == existing().uid
          // Prevent non-admin users from self-promoting or altering moderation badges
          && (!('isVerified' in incoming()) || incoming().isVerified == existing().get('isVerified', false))
          && (!('isBanned' in incoming()) || incoming().isBanned == existing().get('isBanned', false))
          && (!('role' in incoming()) || incoming().role == existing().get('role', 'user'))
        )
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Friend Requests Collection
    match /friendRequests/{requestId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        resource == null ||
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(requestId)
        && incoming().senderId == request.auth.uid
        && incoming().status == 'pending';
      allow update: if isSignedIn() && isValidId(requestId) && (
        isAdmin() ||
        existing().receiverId == request.auth.uid ||
        existing().senderId == request.auth.uid
      );
      allow delete: if isSignedIn() && isValidId(requestId) && (
        isAdmin() ||
        existing().senderId == request.auth.uid ||
        existing().receiverId == request.auth.uid
      );
    }

    // Friends Collection
    match /friends/{friendId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        resource == null ||
        resource.data.uid == request.auth.uid
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(friendId)
        && (incoming().uid == request.auth.uid || incoming().friendUid == request.auth.uid);
      allow update: if isSignedIn() && isValidId(friendId)
        && (isAdmin() || existing().uid == request.auth.uid);
      allow delete: if isSignedIn() && isValidId(friendId)
        && (isAdmin() || existing().uid == request.auth.uid || existing().friendUid == request.auth.uid);
    }

    // Chats Collection
    match /chats/{chatId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        resource == null ||
        request.auth.uid in resource.data.participants
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(chatId)
        && request.auth.uid in incoming().participants
        && incoming().participants.size() == 2;
      allow update: if isSignedIn() && isValidId(chatId)
        && (isAdmin() || request.auth.uid in existing().participants);
      allow delete: if isSignedIn() && isValidId(chatId)
        && (isAdmin() || request.auth.uid in existing().participants);

      // Messages Subcollection (Master Gate pattern + Admin audit/deletion override)
      match /messages/{messageId} {
        allow read: if isSignedIn() && isValidId(messageId) && (
          isAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        allow create: if isSignedIn() && isValidId(messageId)
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && incoming().senderId == request.auth.uid
          && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 2000;
        allow update: if isSignedIn() && isValidId(messageId)
          && (isAdmin() || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow delete: if isSignedIn() && isValidId(messageId)
          && (isAdmin() || existing().senderId == request.auth.uid);
      }
    }
  }
}
